APP_ENV=development
APP_SECRET_KEY=reconx-super-secret-key-for-development-mode-2026!
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/reconx
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session Config
SESSION_COOKIE_NAME=reconx_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# Email & OTP Config
EMAIL_PROVIDER=local
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=notifications@reconx.local
EMAIL_REPLY_TO=support@reconx.local
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# OAuth Config (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# AI Config
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Worker Control & Resource Limits
WORKER_MAX_CONCURRENCY=3
WORKER_DEFAULT_TIMEOUT_SECONDS=300
WORKER_OUTPUT_MAX_BYTES=1048576
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=60
