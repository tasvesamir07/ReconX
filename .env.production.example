# ==============================================================================
# ReconX Production Environment Variables
# Copy this file to .env on your VPS / Server and configure your secrets
# ==============================================================================

# Application Environment & Security
APP_ENV=production
# Generate a random 64-char hex key: openssl rand -hex 32
APP_SECRET_KEY=change_this_to_a_random_32_character_hex_secret_key!

# PostgreSQL Database
POSTGRES_USER=reconx_admin
POSTGRES_PASSWORD=generate_a_strong_database_password_here_2026!
POSTGRES_DB=reconx_prod

# Network URLs & Domains (Change to your domain or server IP)
# For domain: FRONTEND_BASE_URL=https://reconx.yourdomain.com
# For VPS IP: FRONTEND_BASE_URL=http://<YOUR_VPS_IP>:3000
FRONTEND_BASE_URL=http://localhost:3000

# Backend Public API
# For domain: BACKEND_PUBLIC_URL=https://api.yourdomain.com
# For VPS IP: BACKEND_PUBLIC_URL=http://<YOUR_VPS_IP>:8000
BACKEND_PUBLIC_URL=http://localhost:8000

# Next.js Public API URL (used by browser client)
# For domain: NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# For VPS IP: NEXT_PUBLIC_API_URL=http://<YOUR_VPS_IP>:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS Allowed Origins (Comma-separated)
# Must match your frontend domain or IP:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session & HTTPS Security
# Set to 'true' if serving via HTTPS (SSL)
SESSION_COOKIE_SECURE=false

# AI Providers (Groq & Gemini)
# Comma-separated list for high-concurrency rate limit failover
GROQ_API_KEYS=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEYS=AIzaSy_your_gemini_key_1,AIzaSy_your_gemini_key_2
GEMINI_MODEL=gemini-2.5-flash
